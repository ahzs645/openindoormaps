@@ -0,0 +1,9 @@
+/** Keep large GeoJSON inputs out of the bundler's JavaScript object-literal
+ * parser. The source stays JSON, including its numeric and property semantics.
+ * This follows Vite's JSON.stringify strategy for ordinary large JSON imports. */
+export function geojsonModule(source: string): string {
+  const json = source.replace(/^\uFEFF/, "");
+  // Reject malformed source during the build, not on a visitor's first load.
+  JSON.parse(json);
+  return `export default JSON.parse(${JSON.stringify(json)});`;
+}
