+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { runInNewContext } from "node:vm";
+import test from "node:test";
+import { geojsonModule } from "../../scripts/geojson-module";
+
+const evaluate = (source: string) =>
+  runInNewContext(geojsonModule(source).replace(/^export default /, ""), {
+    JSON,
+  });
+
+test("GeoJSON import preserves exact JSON numbers, strings and property names", () => {
+  const source =
+    '{"type":"FeatureCollection","features":[],"coordinates":[-0,1.2345678901234567,1e-300,1.7976931348623157e308],"text":"\\\"\\n\\\\🌲\u2028","__proto__":{"polluted":true},"repeated":1,"repeated":2}';
+  const actual = evaluate(source);
+  assert.deepEqual(actual, JSON.parse(source));
+  assert(Object.is(actual.coordinates[0], -0));
+  assert(Object.hasOwn(actual, "__proto__"));
+  assert.equal(Object.getPrototypeOf(actual), Object.prototype);
+});
+
+test("GeoJSON source fails at build time when malformed and accepts a UTF-8 BOM", () => {
+  assert.throws(() => geojsonModule('{"coordinates":[1,]}'), SyntaxError);
+  assert.throws(() => geojsonModule('{"notJson": undefined}'), SyntaxError);
+  assert.deepEqual(evaluate('\uFEFF{"type":"FeatureCollection","features":[]}'), {
+    type: "FeatureCollection",
+    features: [],
+  });
+});
+
+test("every shipped venue GeoJSON imports without changing its complete data", () => {
+  const directory = fileURLToPath(new URL("../../app/data/", import.meta.url));
+  const files = readdirSync(directory, { recursive: true })
+    .filter((name): name is string => typeof name === "string")
+    .filter((name) => name.endsWith(".geojson"));
+  assert(files.length > 0);
+  for (const name of files) {
+    const source = readFileSync(path.join(directory, name), "utf8");
+    assert.deepEqual(evaluate(source), JSON.parse(source), name);
+  }
+});
