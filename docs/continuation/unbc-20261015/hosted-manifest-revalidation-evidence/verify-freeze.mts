import fs from 'node:fs';
import {createHash} from 'node:crypto';
import {preparedDisplayEngineBinding} from '/workspace/openindoormaps/scripts/indoor/prepared-display-engine-binding.ts';
const root='/workspace/openindoormaps';
const scratch='/workspace/scratch/unbc-pathway-repair-20261015/hosted-manifest-revalidation-qa';
const manifest='/workspace/scratch/unbc-pathway-repair-20261015/regeneration-source-v3-r1-before.json';
const freeze=JSON.parse(fs.readFileSync(manifest,'utf8'));
const sha=(bytes:Uint8Array)=>createHash('sha256').update(bytes).digest('hex');
const drift=Object.entries(freeze.files).filter(([name,hash])=>sha(fs.readFileSync(name))!==hash);
if(drift.length)throw Error(JSON.stringify(drift));
const engine=preparedDisplayEngineBinding(root);
const earlier=JSON.parse(fs.readFileSync('/workspace/scratch/unbc-pathway-repair-20261015/progressive-route-cache-qa/freeze-and-engine-before.json','utf8')).officialPreparationEngine;
if(JSON.stringify(engine)!==JSON.stringify(earlier))throw Error('Official preparation engine graph changed');
const oldEngine=fs.readFileSync('/workspace/scratch/unbc-pathway-repair-20261015/stair-clearance/postcompile-tooling/historical-before-images-v3-r1/prepared-display-engine-binding.ts');
const generated=fs.readFileSync(root+'/app/indoor-project/prepared-display-engine-binding.ts');
if(!oldEngine.equals(generated))throw Error('Generated engine bytes changed');
const rows=['app/indoor-project/hosted-project.ts','tests/unit/hosted-project.test.ts'].map(name=>({path:name,sha256:sha(fs.readFileSync(root+'/'+name)),inMainFreeze:Object.hasOwn(freeze.files,root+'/'+name),inPreparationClosure:engine.modules.some(([p])=>p===name)}));
if(rows.some(r=>r.inMainFreeze||r.inPreparationClosure))throw Error('Edited frozen source');
const result={mainFreezeManifest:manifest,mainFreezeManifestSha256:sha(fs.readFileSync(manifest)),frozenFiles:Object.keys(freeze.files).length,frozenChanges:drift,officialPreparationEngine:engine,generatedEngineExactBytesEqual:true,generatedEngineSourceSha256:sha(generated),changedSources:rows};
fs.writeFileSync(scratch+'/freeze-check.json',JSON.stringify(result,null,2)+'\n');
console.log(JSON.stringify({frozenFiles:result.frozenFiles,frozenChanges:0,engine:engine.sha256,engineModules:engine.modules.length,generatedEngineExactBytesEqual:true,changedSources:rows}));
