+test("whole-area boolean support preserves the exact tile/intersection/difference result", () => {
+  const tiny = new Rational(1n, 10n ** 30n);
+  const sources: Parts[] = [
+    [],
+    rect(-64, -64, 64, 64),
+    [[rect(-64, -64, 64, 64)[0]![0]!, rect(-1, -1, 1, 1)[0]![0]!]],
+    [...rect(-64, -64, 0, 64), ...rect(tiny, -64, 64, 64)],
+    [...rect(-64, -64, 64, 64), ...rect(128, 128, 130, 130)],
+  ];
+  const demands = [
+    rect(-1, -1, 1, 1),
+    rect(-33, -2, -31, 2),
+    rect(31, -2, 33, 2),
+    rect(-100, -100, 100, 100),
+    rect(64, 0, 65, 1),
+    rect(63, 0, 64, 1),
+    rect(0, 0, tiny, 1),
+  ];
+  for (const source of sources) {
+    const supports = createNativeRationalAreaSupportQuery(source);
+    const clipped = createNativeRationalSupportTileQuery(source);
+    for (const demand of demands)
+      for (const extra of [
+        [],
+        rect(-2, -2, 2, 2),
+        [[rect(-2, -2, 2, 2)[0]![0]!, rect(-0.5, -0.5, 0.5, 0.5)[0]![0]!]],
+      ] as Parts[]) {
+        const before = [encoded(source), encoded(demand), encoded(extra)];
+        const old =
+          overlay("difference", demand, clipped(demand), extra).length === 0;
+        const direct =
+          overlay("difference", demand, source, extra).length === 0;
+        assert.equal(supports(demand, extra), old);
+        assert.equal(supports(demand, extra), direct);
+        assert.deepEqual(
+          [encoded(source), encoded(demand), encoded(extra)],
+          before,
+        );
+      }
+  }
+});
+
