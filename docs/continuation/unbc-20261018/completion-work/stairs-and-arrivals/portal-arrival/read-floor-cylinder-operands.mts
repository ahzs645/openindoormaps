const scopedPath='/workspace/scratch/source-portal-arrival-20261018/scoped-floor-demand.json',scopedBytes=await readFile(scopedPath),scoped=JSON.parse(scopedBytes.toString()),attributionPath='/workspace/scratch/source-portal-arrival-20261018/floor-boundary-attribution.json',attributionBytes=await readFile(attributionPath),attribution=JSON.parse(attributionBytes.toString()),hash=b=>createHash('sha256').update(b).digest('hex'),results=[];
