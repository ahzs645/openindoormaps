From 9ecce8d90e7b66fbe561b865d8a423f504ad3bf9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 20:29:39 -0700
Subject: [PATCH] fix(indoor): keep the contact rule out of the circulation
 geometry key

A regeneration starts by importing a master compiled before the rule. With the
rule in the key that master's circulation is stale, and the import refuses its
walk edges. The rule stays versioned in the compiler's private physical memo
and in the module hashes of the regeneration receipts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/indoor-project/native-circulation.ts                     | 2 --
 app/indoor-project/prepared-display-engine-binding.ts        | 2 +-
 app/indoor-project/published-route-runtime-binding.ts        | 2 +-
 app/indoor-project/published-visitor-plan-runtime-binding.ts | 2 +-
 4 files changed, 3 insertions(+), 5 deletions(-)

diff --git a/app/indoor-project/native-circulation.ts b/app/indoor-project/native-circulation.ts
index 49180ab..6f5deb3 100644
--- a/app/indoor-project/native-circulation.ts
+++ b/app/indoor-project/native-circulation.ts
@@ -24,7 +24,6 @@ import type { IndoorDataset, IndoorRecord } from "./contract";
