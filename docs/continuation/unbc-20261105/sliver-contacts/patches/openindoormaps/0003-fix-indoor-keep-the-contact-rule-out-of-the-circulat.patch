 import { createNativeIndoorEnvelopeIndex } from "./native-indoor-envelopes";
 import { NATIVE_BARRIER_TOPOLOGY_VERSION } from "./native-barrier-topology";
-import { NATIVE_ROUTING_CONTACT_NODING_VERSION } from "./native-routing-contact-noding";
 import { NATIVE_ACCESS_ZONES_VERSION } from "./native-access-zones";
 import { nativeRoutingAccessZonesAt } from "./native-routing-access-zones";
 import {
@@ -409,7 +408,6 @@ export function nativeCirculationGeometryKey(data: IndoorDataset): string {
               "native-door-approach-original-source-bounds-v1",
               NATIVE_RATIONAL_OVERLAY_KERNEL_VERSION,
               NATIVE_EXACT_GEOS_BINDING,
-              NATIVE_ROUTING_CONTACT_NODING_VERSION,
               nativeConnectorAnchors(data),
               ...(data.nativePhysicalLevels ? [data.nativePhysicalLevels] : []),
               ...(data.nativeAccessZones
