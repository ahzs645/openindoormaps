index 0000000..c7119d3
--- /dev/null
+++ b/tests/unit/native-routing-contact-noding.test.ts
@@ -0,0 +1,52 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  NATIVE_ROUTING_CONTACT_NODING_VERSION,
+  nativeRoutingContactNoding,
+} from "../../app/indoor-project/native-routing-contact-noding.ts";
+import { nativeRationalOverlay } from "../../app/indoor-project/native-rational-overlay.ts";
+import { nativeRationalPathSupported } from "../../app/indoor-project/native-exact-planar-topology.ts";
+
+type P = [number, number];
+const rect = (x0: number, y0: number, x1: number, y1: number): P[] => [
+  [x0, y0],
+  [x1, y0],
+  [x1, y1],
+  [x0, y1],
+];
+const room = rect(0, 0, 20, 10),
+  top = [rect(0, 9.8, 20, 10)],
+  partition = (gap: number) => [rect(10, 0, 10.2, 9.8 - gap)];
+const free = (box: P[], walls: P[][][]) =>
+  nativeRationalOverlay("difference", [[box]], ...walls.map((wall) => [wall]));
+
+test("runtime mirror closes numerical partition contacts only", () => {
+  assert.match(NATIVE_ROUTING_CONTACT_NODING_VERSION, /1e-7ft/);
+  for (const gap of [1e-14, 1e-9, 5e-8]) {
+    assert.equal(free(room, [top, partition(gap)]).length, 1);
+    const after = free(room, nativeRoutingContactNoding([top, partition(gap)]));
+    assert.equal(after.length, 2, `${gap} ft`);
+    assert.equal(
+      nativeRationalPathSupported([[5, 9.8 - gap / 2], [15, 9.8 - gap / 2]], after),
+      false,
+    );
+  }
+  for (const gap of [1e-6, 0.02]) {
+    const walls = [top, partition(gap)],
+      noded = nativeRoutingContactNoding(walls);
+    assert.equal(noded[0], walls[0]);
+    assert.equal(noded[1], walls[1]);
+  }
+});
+
+test("runtime mirror keeps a door aperture open and is idempotent", () => {
+  const box = rect(0, 0, 20, 12),
+    walls = [[rect(0, 9.8, 10.2, 10)], [rect(13.2, 9.8, 20, 10)], partition(1e-14)];
+  const once = nativeRoutingContactNoding(walls),
+    after = free(box, once);
+  assert.equal(after.length, 2);
+  assert.equal(nativeRationalPathSupported([[11.7, 5], [11.7, 11]], after), true);
+  const twice = nativeRoutingContactNoding(once);
+  twice.forEach((w, i) => assert.equal(w, once[i]));
+  assert.throws(() => nativeRoutingContactNoding(walls, 1e-6), /at most 1e-7/);
+});
