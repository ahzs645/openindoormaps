+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {nativeRoutingContactNoding,NATIVE_ROUTING_CONTACT_NODING_VERSION} from '../lib/reviter/native-routing-contact-noding.ts';
+import {nativeRationalOverlay} from '../lib/reviter/native-rational-overlay.ts';
+import {nativeRationalPathSupported} from '../lib/reviter/native-exact-planar-topology.ts';
+import {nativeWalkingRegion} from '../lib/reviter/native-circulation-links.ts';
+import {nativeCirculationGeometryKey} from '../lib/reviter/native-circulation-geometry.ts';
+import type {IndoorDataset} from '../lib/reviter/indoor-contract.ts';
+import type {ConvertResult} from '../lib/reviter/types.ts';
+import {readFileSync} from 'node:fs';
+import {pathToFileURL} from 'node:url';
+// The runtime sibling; a worktree can point at its paired checkout instead.
+const OIM=process.env.OPENINDOORMAPS_ROOT?pathToFileURL(process.env.OPENINDOORMAPS_ROOT.replace(/\/?$/,'/')).href:new URL('../../openindoormaps/',import.meta.url).href;
+type P=[number,number];
+const rect=(x0:number,y0:number,x1:number,y1:number):P[]=>[[x0,y0],[x1,y0],[x1,y1],[x0,y1]];
+const free=(box:P[],walls:P[][][])=>nativeRationalOverlay('difference',[[box]],...walls);
+const room=rect(0,0,20,10),top=[rect(0,9.8,20,10)];
+// Partition from the floor edge up to the top wall, ending `gap` short of its face.
+const partition=(gap:number)=>[rect(10,0,10.2,9.8-gap)];
+
+test('a partition ending a floating-point residue short of a wall is closed; a measured gap stays open',()=>{
+ for(const gap of [1e-14,1e-9,5e-8]){
+  assert.equal(free(room,[top,partition(gap)]).length,1,`the ${gap} ft sliver joins both rooms before noding`);
+  const noded=nativeRoutingContactNoding([top,partition(gap)]);
+  assert.equal(free(room,noded).length,2,`${gap} ft is a numerical contact and separates the rooms`);
+  assert.equal(noded[1],noded[1]);
+  assert.equal(nativeRationalPathSupported([[5,9.8-gap/2],[15,9.8-gap/2]],free(room,noded)),false,'no walk runs over the partition end');
+ }
+ for(const gap of [1e-6,0.02]){
+  const walls=[top,partition(gap)],noded=nativeRoutingContactNoding(walls);
+  assert.deepEqual(noded,walls,`${gap} ft is a measured gap and is never closed`);
+  assert.equal(noded[0],walls[0]);assert.equal(noded[1],walls[1]);
+  assert.equal(free(room,noded).length,1);
+ }
+});
+
+test('only material is added: exact contacts and overlaps return the same walls',()=>{
+ for(const end of [9.8,9.8+1e-14,9.9]){
+  const walls=[top,[rect(10,0,10.2,end)]],noded=nativeRoutingContactNoding(walls);
+  assert.equal(noded[0],walls[0]);assert.equal(noded[1],walls[1]);
+  assert.equal(free(room,noded).length,2);
+ }
+ const walls=[top,partition(1e-14)],noded=nativeRoutingContactNoding(walls);
+ assert.equal(noded[1],walls[1],'the partition keeps its original coordinates');
+ assert.deepEqual(noded[0]![0]!.filter(p=>!walls[0]![0]!.some(q=>q[0]===p[0]&&q[1]===p[1])),[[10,9.8-1e-14],[10.2,9.8-1e-14]],'the wall gains the partition corners, unchanged');
+ assert.deepEqual(nativeRationalOverlay('difference',nativeRationalOverlay('union',walls[0]!),noded[0]!),[],'no original wall area is removed');
+});
+
+test('a door aperture beside a numerical contact stays open',()=>{
+ // Host wall with a 3 ft aperture whose jamb is flush with the partition face.
+ const box=rect(0,0,20,12),left=[rect(0,9.8,10.2,10)],right=[rect(13.2,9.8,20,10)];
+ const walls=[left,right,partition(1e-14)];
+ assert.equal(free(box,walls).length,1);
+ const noded=nativeRoutingContactNoding(walls),after=free(box,noded);
+ assert.equal(after.length,2,'the room left of the partition is closed off');
+ assert.equal(nativeRationalPathSupported([[11.7,5],[11.7,11]],after),true,'the aperture remains walkable');
+ assert.equal(nativeRationalPathSupported([[10.1,9.9],[10.1,9.9]],after),false);
+ assert.equal(noded[1],walls[1],'the far jamb is untouched');
+});
+
+test('an end-to-end corner joint is closed at its shared corners',()=>{
+ for(const gap of [1e-14,3.5e-15,6e-8]){
+  const box=rect(0,0,20,12),beam=[rect(0,9.8,10,10)],post=[rect(10+gap,0,10.2,10)];
+  assert.equal(free(box,[beam,post]).length,1);
+  assert.equal(free(box,nativeRoutingContactNoding([beam,post])).length,2,`${gap} ft corner contact`);
+ }
+ // Collinear pieces of one element, as exported for 03-2092/03-2094.
+ const box=rect(0,-1,10,2),a=[rect(0,0,4.000000000000001,1)],b=[rect(4.000000000000002,0,10,1)];
+ assert.equal(free(box,[a,b]).length,1);
+ assert.equal(free(box,nativeRoutingContactNoding([a,b])).length,2);
+});
+
+test('noding is idempotent and bounded',()=>{
+ const walls=[top,partition(1e-14),[rect(13,0,13.2,9.8-5e-8)]],once=nativeRoutingContactNoding(walls),twice=nativeRoutingContactNoding(once);
+ assert.deepEqual(twice,once);twice.forEach((w,i)=>assert.equal(w,once[i]));
+ assert.throws(()=>nativeRoutingContactNoding(walls,1e-6),/at most 1e-7/);
+ assert.throws(()=>nativeRoutingContactNoding(walls,Number.NaN),/at most 1e-7/);
+});
+
+const rec=(key:string,x0:number,x1:number)=>({key,number:key,name:key,building:'T',levelId:1,elevationFeet:0,elevationEvidence:'native floor',surfaceId:`${key}:1`,circulation:false,stair:false,walkable:true,access:'unknown',confidence:1,ringsFeet:[rect(x0,0,x1,10)],properties:{}});
+async function strictData(gap:number){
+ const {nativeIndoorEnvelopeHash}=await import('../lib/reviter/native-indoor-envelopes.ts');
+ const {nativeMaterialSectionsHash}=await import('../lib/reviter/native-material-sections.ts');
+ const sha='a'.repeat(64);
+ const envelope={version:1 as const,sourceModelSha256:sha,levels:[{levelId:1,elevationFeet:0,partsFeet:[[room]],sourceElementIds:[10,20,21],cutElevationsFeet:[4,8],evidenceSha256:'b'.repeat(64)}]};
+ const section=(id:number,parts:P[][][])=>({nativeElementId:id,categoryId:-2000011,kind:'wall' as const,baseElevationFeet:0,topElevationFeet:8,partsFeet:parts});
+ const material={version:1 as const,sourceModelSha256:sha,levels:[{levelId:1,elevationFeet:0,cutElevationFeet:.1,evidenceSha256:'c'.repeat(64),sourceElementIds:[20,21],sections:[section(20,[top]),section(21,[partition(gap)])]}]};
+ const data={source:{modelSha256:sha},nativeLevels:[{id:1,name:'A',elevationFeet:0}],records:[rec('a',0,10),rec('b',10.2,20)],nodes:[],edges:[],walls:[],doors:[],
+  alignment:{horizontalMetresPerFoot:.3048},
+  nativeIndoorEnvelopes:{...envelope,geometrySha256:await nativeIndoorEnvelopeHash(envelope)},
+  nativeMaterialSections:{...material,geometrySha256:await nativeMaterialSectionsHash(material)},
+  walkingSupport:{version:1 as const,sourceModelSha256:sha,floors:[{nativeElementId:10,elevationFeet:0,ringsFeet:[room]}]}} as unknown as IndoorDataset;
+ const floor={elementId:10,categoryId:-2000032,boundsFeet:{min:{x:0,y:0,z:-1},max:{x:20,y:10,z:0}},loops:[room.map(p=>[...p,0])]};
+ const model={elementBounds:[floor],levels:[{levelId:1,elevation:0}],nativeAssociatedLevelRelations:[],nativeHostRelations:[]} as unknown as ConvertResult;
+ return {data,model};
+}
+
+test('the exact walking region separates rooms at a numerical partition contact only',async()=>{
+ for(const [gap,faces] of [[1e-14,2],[5e-8,2],[1e-6,1],[0.02,1]] as const){
+  const {data,model}=await strictData(gap);
+  const region=nativeWalkingRegion(model,data,0,true);
+  assert.equal(region.exact!.free.length,faces,`${gap} ft`);
+  assert.equal(nativeRationalPathSupported([[5,9.8-gap/2],[15,9.8-gap/2]],region.exact!.free),faces===1);
+ }
+});
+
+test('prepared circulation geometry is bound to the contact rule in the compiler and the runtime',async()=>{
+ const {data}=await strictData(1e-14);
+ assert.match(NATIVE_ROUTING_CONTACT_NODING_VERSION,/1e-7ft/);
+ const runtime=await import(OIM+'app/indoor-project/native-routing-contact-noding.ts');
+ assert.equal(runtime.NATIVE_ROUTING_CONTACT_NODING_VERSION,NATIVE_ROUTING_CONTACT_NODING_VERSION);
+ const {nativeCirculationGeometryKey:runtimeKey}=await import(OIM+'app/indoor-project/native-circulation.ts');
+ assert.equal(runtimeKey(data),nativeCirculationGeometryKey(data),'compiler and runtime bind the same geometry');
+ const key=readFileSync(new URL('../lib/reviter/native-circulation-geometry.ts',import.meta.url),'utf8');
